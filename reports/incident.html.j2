<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Incident Report -- {{ incident.ip }}</title>
  <style>
    body { font-family: Helvetica, Arial, sans-serif; color: #222; margin: 40px; font-size: 12px; }
    h1   { color: #b00020; border-bottom: 2px solid #b00020; padding-bottom: 6px; }
    h2   { color: #444; margin-top: 24px; }
    table { border-collapse: collapse; width: 100%; margin: 12px 0; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; vertical-align: top; }
    th    { background: #f5f5f5; width: 180px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; color: white; font-size: 11px; }
    .malicious { background: #b00020; }
    .benign    { background: #1f7a32; }
    .unknown   { background: #888; }
    .meta { color: #666; font-size: 11px; }
    pre  { background: #f7f7f7; padding: 10px; border: 1px solid #e0e0e0; font-size: 11px; }
    .footer { margin-top: 40px; color: #888; font-size: 10px; border-top: 1px solid #eee; padding-top: 8px; }
  </style>
</head>
<body>
  <h1>Autonomous SIEM -- Incident Report</h1>
  <p class="meta">Generated: {{ generated_at }} &middot; Incident ID: {{ incident.id }}</p>

  <h2>Summary</h2>
  <table>
    <tr><th>Source IP</th>     <td>{{ incident.ip }}</td></tr>
    <tr><th>First seen</th>    <td>{{ incident.first_seen }}</td></tr>
    <tr><th>Last seen</th>     <td>{{ incident.last_seen }}</td></tr>
    <tr><th>Attempt count</th> <td>{{ incident.attempt_count }}</td></tr>
    <tr><th>Users targeted</th><td>{{ incident.users | join(", ") }}</td></tr>
    <tr><th>Rule verdict</th>  <td><span class="badge {{ incident.rule_verdict }}">{{ incident.rule_verdict }}</span></td></tr>
    <tr><th>ML verdict</th>    <td><span class="badge {{ incident.ml_verdict }}">{{ incident.ml_verdict }}</span> (score {{ "%.3f"|format(incident.ml_score) }})</td></tr>
    <tr><th>Final verdict</th> <td><span class="badge {{ incident.final_verdict }}">{{ incident.final_verdict }}</span></td></tr>
  </table>

  <h2>Actions taken</h2>
  <table>
    <tr><th>iptables</th>        <td>INPUT -s {{ incident.ip }} -j DROP (TTL {{ response.ttl_sec }}s)</td></tr>
    <tr><th>Sessions killed</th> <td>{{ response.sessions_killed }}</td></tr>
    <tr><th>Trigger reason</th>  <td>{{ response.reason }}</td></tr>
    <tr><th>Logged to</th>       <td>SQLite responses table + Elasticsearch siem-response index</td></tr>
  </table>

  <h2>Rollback</h2>
  <pre>sudo iptables -D INPUT -s {{ incident.ip }} -j DROP</pre>
  <p class="meta">Auto-rollback runs after the TTL expires; this command is the manual override.</p>

  <h2>Indicators of compromise</h2>
  <ul>
    <li>Source IP: <code>{{ incident.ip }}</code></li>
    {% for u in incident.users %}<li>Targeted username: <code>{{ u }}</code></li>{% endfor %}
  </ul>

  <p class="footer">Autonomous SIEM &middot; Final Year Project &middot; lab-only auto-response</p>
</body>
</html>
