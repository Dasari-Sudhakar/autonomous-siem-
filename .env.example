ES_URL=http://localhost:9200
ES_INDEX=filebeat-*
ALERTS_INDEX=siem-alerts
RESPONSE_INDEX=siem-response

RULE_WINDOW_SECONDS=60
RULE_THRESHOLD=5
BLOCK_TTL_SECONDS=3600
POLL_INTERVAL_SECONDS=10

SQLITE_PATH=/var/lib/siem/responses.db
MODEL_PATH=ml/isolation_forest.pkl

ENABLE_RESPONDER=true
DRY_RUN=false

# Target VM (separate Ubuntu Server VM running sshd + Filebeat)
TARGET_HOST=192.168.56.12
TARGET_USER=siem
TARGET_SSH_KEY=~/.ssh/siem_orchestrator_ed25519
TARGET_SSH_TIMEOUT=10
